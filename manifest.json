{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Ops Toolshed",
  "version": "1.6",
  "description": "Enhances Prisma functionality and provides quick access to various tools. Built by Harry Barnes.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "offscreen",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://groupmuk-prisma.mediaocean.com/*",
    "https://go.demo.mediaocean.com/*",
    "https://insidemedia.sharepoint.com/*",
    "https://graph.facebook.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://cdnjs.cloudflare.com https://fonts.googleapis.com; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "help-guides.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mediaocean.com/*"],
      "js": ["features/applearn-popup-guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.mediaocean.com/*"],
      "js": ["features/applearn-popup-guard-controller.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.mediaocean.com/*"],
      "js": [
        "utils.js",
        "features/feedback-modal.js",
        "features/logo.js",
        "features/reminders.js",
        "features/campaign.js",
        "features/campaign-tab-title.js",
        "features/d-number-search.js",
        "features/gmi-chat.js",
        "features/live-chat-enhancements.js",
        "features/approver-pasting.js",
        "features/stats-collector.js",
        "features/placement-counter.js",
        "features/banner-username.js",
        "features/swap-accounts.js",
        "features/auto-copy-url.js",
        "features/order-id-copy.js",
        "features/order-view-toggle.js",
        "features/actualise-navbar.js",
        "features/actualise-shortcut.js",
        "features/actualise-scroll-restore.js",
        "features/loading-facts.js",
        "features/help-guides-launcher.js",
        "features/onboarding-tour.js",
        "features/applearn-replace.js",
        "content.js"
      ],
      "css": ["approvers.css", "content.css", "features/feedback-modal.css"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [{
    "resources": [
      "icon.png",
      "features/swap-accounts.css"
    ],
    "matches": ["https://*.mediaocean.com/*"]
  }]
}
