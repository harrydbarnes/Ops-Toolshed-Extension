{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Ops Toolshed",
  "version": "1.9",
  "description": "Enhances Prisma functionality and provides quick access to various tools. Built by Harry Barnes.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "offscreen",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.mediaocean.com/*",
    "https://groupmuk-prisma.mediaocean.com/*",
    "https://go.demo.mediaocean.com/*",
    "https://insidemedia.sharepoint.com/*",
    "https://graph.facebook.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://cdnjs.cloudflare.com https://fonts.googleapis.com; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "side_panel": {
    "default_path": "help-guides.html"
  },
  "web_accessible_resources": [{
    "resources": [
      "icon.png",
      "features/swap-accounts.css"
    ],
    "matches": ["https://*.mediaocean.com/*"]
  }]
}
